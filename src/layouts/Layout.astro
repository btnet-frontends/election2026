---
import Gototop from '../components/Gototop.vue';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  shareImage?: string;
  shareImageAlt?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  footerBgColor?: string;
}

const {
  title,
  description = "2026縣市長選舉《今周刊》戰情室一次掌握！2026年九合一選舉11/28舉行，「藍綠白」爭奪22個縣市版圖、派出黨內菁英一決高下。關於最新選舉開票、即時新聞、選情分析，以及縣市長候選人深入報導，《今周刊》戰情室一次掌握。",
  canonical: canonicalProp,
  shareImage = "https://www.businesstoday.com.tw/bt_topic/2026/election/share.jpg",
  shareImageAlt = "2026九合一大選《今周戰情室》",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  structuredData,
  footerBgColor = "var(--color-coffee-50)"
} = Astro.props;

const canonical = canonicalProp ?? new URL(Astro.url.pathname, Astro.site).href;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null;
---

<!DOCTYPE html>
<html lang="zh-Hant-TW">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
  <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
  <meta name="generator" content={Astro.generator} />
  <slot name="head-extra" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="今周刊" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="zh-Hant-TW" href={canonical} />
  <link rel="sitemap" type="application/xml" href="https://www.businesstoday.com.tw/bt_topic/2026/election/sitemap.xml" />

  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:secure_url" content={shareImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1199" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={shareImageAlt} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content="今周刊" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={shareImageAlt} />

  {structuredDataJson && (
    <script type="application/ld+json" is:inline set:html={structuredDataJson}></script>
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap" rel="stylesheet" />

  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-4950332-1"></script>
	<script>
		window.dataLayer = window.dataLayer || [];

		function gtag() {
			dataLayer.push(arguments);
		}
		gtag('js', new Date());
		gtag('config', 'UA-4950332-1');
	</script>

	<!-- Google Tag Manager -->
	<script>
		(function (w, d, s, l, i) {
			w[l] = w[l] || [];
			w[l].push({
				'gtm.start': new Date().getTime(),
				event: 'gtm.js'
			});
			var f = d.getElementsByTagName(s)[0],
				j = d.createElement(s),
				dl = l != 'dataLayer' ? '&l=' + l : '';
			j.async = true;
			j.src =
				'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
			f.parentNode.insertBefore(j, f);
		})(window, document, 'script', 'dataLayer', 'GTM-KT67283');
	</script>
	<!-- End Google Tag Manager -->

	<!-- Matomo -->
	<script>
		function getMCookie(name) {
			const value = `; ${document.cookie}`;
			const parts = value.split(`; ${name}=`);
			if (parts.length === 2) return parts.pop().split(';').shift();
		}
		var _paq = window._paq = window._paq || [];
		/* tracker methods like "setCustomDimension" should be called before "trackPageView" */
		_paq.push(['trackPageView']);
		_paq.push(['enableLinkTracking']);
		(function () {
			var u = "//matomo.businesstoday.com.tw/";
			_paq.push(['setTrackerUrl', u + 'matomo.php']);
			_paq.push(['setSiteId', '4']);
			_paq.push(['setUserId', getMCookie('businesstoday')]);
			var d = document,
				g = d.createElement('script'),
				s = d.getElementsByTagName('script')[0];
			g.async = true;
			g.src = u + 'matomo.js';
			s.parentNode.insertBefore(g, s);
		})();
	</script>
	<!-- End Matomo Code -->
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KT67283" height="0" width="0"
        style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <div class="site-footer-wrapper" style={`background-color: ${footerBgColor};`}>
      <footer class="site-footer">
        <div class="container footer-container">
          <div class="footer-badge">今周刊數位內容部</div>
          <p class="copyright">
            Copyright © 2026 今周刊 All rights reserved. 版權所有，禁止擅自轉貼節錄
          </p>
        </div>
      </footer>
    </div>

    <Gototop client:load />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #C7161D;          /* 今周刊標準色 */
    --color-primary-rgb: 199, 22, 29;

    --color-coffee-0:   #ffffff;
    --color-coffee-50:  #F3EEEA;
    --color-coffee-100: #CBC1B5;
    --color-coffee-150: #F1EAE3;
    --color-coffee-200: #E6DFD7;
    --color-coffee-300: #917F6B;
    --color-coffee-600: #6B5C4B;
    --color-coffee-600-rgb: 107, 92, 75;
    --color-coffee-900: #332A21;
    --color-coffee-accent: #8E5F28;

    --color-green: #7CFFB0;
    --color-blue:  #227EFF;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Inter', 'Noto Sans TC', sans-serif;
    font-size: 16px;
    color: var(--color-coffee-900);
    background-color: var(--color-coffee-50);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    overflow-x: hidden;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  button {
    font-family: inherit;
    border: none;
    background: none;
    cursor: pointer;
    outline: none;
  }

  ul, ol {
    list-style: none;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1.25rem;
    padding-left: 1.25rem;
  }

  @media (min-width: 576px) {
    .container {
      max-width: 540px;
    }
  }

  @media (min-width: 768px) {
    .container {
      max-width: 720px;
      padding-right: 1.5rem;
      padding-left: 1.5rem;
    }
  }

  @media (min-width: 992px) {
    .container {
      max-width: 960px;
    }
  }

  @media (min-width: 1200px) {
    .container {
      max-width: 1000px;
    }
  }

  section, #flash-news, #tags {
    scroll-margin-top: 104px; /* Header 高度 76px + top offset 20px + 8px 餘裕 */
  }

  .glass {
    background: rgba(252, 251, 249, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  ::-webkit-scrollbar-track {
    background: var(--color-coffee-50);
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

.site-footer-wrapper {
  position: relative;
  z-index: 5;
  width: 100%;
}

.site-footer {
  border-radius: 80px 80px 0 0;
  background: linear-gradient(135deg, var(--color-green) 0%, var(--color-blue) 100%);
  color: #ffffff;
  padding: 2rem 0;
  text-align: center;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.footer-badge {
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  opacity: 0.9;
}

.copyright {
  font-size: 0.88rem;
  font-weight: 400;
  opacity: 0.85;
  letter-spacing: 0.02em;
  line-height: 1.6;
  max-width: 600px;
}
@media (max-width: 768px) {
  .site-footer {
    padding: 2.5rem 1.5rem;
  }
  
  .copyright {
    font-size: 0.8rem;
  }
}
</style>
