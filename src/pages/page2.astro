---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.vue';
import KV from '../components/Kv.vue';
import FlashNews from '../components/FlashNews.vue';
import NewsReport from '../components/NewsReport.vue';
import PollsChart from '../components/PollsChart.vue';
import LiveStreaming from '../components/LiveStreaming.vue';
import Vote from '../components/Vote.vue';
import Seats from '../components/Seats.vue';
import VoteAnalysis from '../components/voteAnalysis.vue';
import PartyHistory from '../components/PartyHistory.vue';

import config from '../json/data.json';
import { buildNewsApiUrl, getTagApi } from '../utils/newsApi.js';
import { buildFlashNewsList } from '../utils/newsUtils.js';
import { fetchSeatHistory } from '../utils/seatHistoryApi.js';
import { fetchElectionStat } from '../utils/electionStatApi.js';

const componentVisibility = {
  KV: config.components?.KV !== false,
  FlashNews: config.components?.FlashNews !== false,
  NewsReport: config.components?.NewsReport !== false,
  PollsChart: config.components?.PollsChart !== false,
  LiveStreaming: config.components?.LiveStreaming !== false,
  Vote: config.components?.Vote !== false,
  Seats: config.components?.Seats !== false,
  VoteAnalysis: config.components?.VoteAnalysis !== false,
  PartyHistory: config.components?.PartyHistory !== false
};

const hotTags = config.newsReport.hotTags;
const defaultTagApi = getTagApi(hotTags[0]);
const flashNewsTag = config.flashNews?.tag || hotTags[0];
const flashNewsApi = getTagApi(flashNewsTag);

const getEmptyNewsData = (): NewsData => ({
  article_lists: [],
  page_model: { currentPage: 1, lastPage: 1 }
});

const fetchNewsByApi = async (api: any, label: string): Promise<NewsData> => {
  let newsData = getEmptyNewsData();

  try {
    if (api?.tagName) {
      const response = await fetch(buildNewsApiUrl(api), {
        headers: {
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
        }
      });
      if (response.ok) {
        newsData = await response.json();
      } else {
        console.error(`Astro 靜態抓取${label}今周刊 API 失敗: ${response.status}`);
      }
    }
  } catch (error) {
    console.error(`Astro 靜態抓取${label}今周刊 API 發生異常:`, error);
  }

  return newsData;
};

const fallbackNewsData = {
  article_lists: config.newsReport.fallbackNews,
  page_model: { currentPage: 1, lastPage: 1 }
};

let initialNews = getEmptyNewsData();

if (componentVisibility.NewsReport) {
  initialNews = await fetchNewsByApi(defaultTagApi, '新聞列表');

  if (!initialNews.article_lists || initialNews.article_lists.length === 0) {
    initialNews = fallbackNewsData;
  }
}

type FlashNewsItem = { text: string; date: string; link: string };
let flashNewsList: FlashNewsItem[] = [];

if (componentVisibility.FlashNews) {
  const flashNewsLimit = flashNewsApi?.limit || 4;
  let initialFlashNews = getEmptyNewsData();
  const canReuseInitialNewsForFlash =
    componentVisibility.NewsReport &&
    defaultTagApi?.tagName === flashNewsApi?.tagName &&
    initialNews.article_lists.length >= flashNewsLimit;

  if (canReuseInitialNewsForFlash) {
    initialFlashNews = initialNews;
  } else {
    initialFlashNews = await fetchNewsByApi(flashNewsApi, '快訊');
  }

  const fallbackFlashNewsList = initialNews.article_lists?.length
    ? initialNews.article_lists
    : fallbackNewsData.article_lists;

  flashNewsList = buildFlashNewsList(
    initialFlashNews.article_lists?.length ? initialFlashNews.article_lists : fallbackFlashNewsList,
    flashNewsLimit
  );
}

const seatHistory = componentVisibility.Seats ? await fetchSeatHistory() : null;
const electionStat = componentVisibility.VoteAnalysis ? await fetchElectionStat() : null;

const footerBgColor = componentVisibility.PollsChart ? 'var(--color-coffee-50)' : 'var(--color-coffee-0)';

const seoTitle = '2026縣市長選舉《今周戰情室》- 今周刊';
const seoDescription = '2026縣市長選舉《今周刊》戰情室一次掌握！2026年九合一選舉11/28舉行，「藍綠白」爭奪22個縣市版圖、派出黨內菁英一決高下。關於最新選舉開票、即時新聞、選情分析，以及縣市長候選人深入報導，《今周刊》戰情室一次掌握。';
const canonicalUrl = 'https://www.businesstoday.com.tw/bt_topic/2026/election/';
const shareImageUrl = `${canonicalUrl}share.jpg`;
const organizationId = 'https://www.businesstoday.com.tw/#organization';
const websiteId = 'https://www.businesstoday.com.tw/#website';
const webpageId = `${canonicalUrl}#webpage`;

const stripHtml = (value = '') => value.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const isArticleUrl = (value = '') => {
  try {
    const url = new URL(value);
    return url.hostname === 'www.businesstoday.com.tw' && url.pathname.includes('/article/');
  } catch {
    return false;
  }
};

const structuredNewsItems = initialNews.article_lists
  .filter((item) => item?.title && isArticleUrl(item?.output_link_path))
  .slice(0, 10)
  .map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: item.output_link_path,
    name: stripHtml(item.title),
    ...(item.image_url ? { image: item.image_url } : {})
  }));

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: '今周刊',
      alternateName: 'Business Today',
      url: 'https://www.businesstoday.com.tw/',
      sameAs: [
        'https://www.facebook.com/BToday/',
        'https://www.instagram.com/btoday_ig/'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: 'https://www.businesstoday.com.tw/',
      name: '今周刊',
      inLanguage: 'zh-Hant-TW',
      publisher: { '@id': organizationId }
    },
    {
      '@type': 'CollectionPage',
      '@id': webpageId,
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': websiteId },
      publisher: { '@id': organizationId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: shareImageUrl,
        width: 1199,
        height: 630
      },
      about: [
        { '@type': 'Thing', name: '2026九合一選舉' },
        { '@type': 'Thing', name: '2026縣市長選舉' }
      ],
      ...(structuredNewsItems.length
        ? { mainEntity: { '@id': `${canonicalUrl}#news-list` } }
        : {})
    },
    ...(structuredNewsItems.length
      ? [{
          '@type': 'ItemList',
          '@id': `${canonicalUrl}#news-list`,
          name: '2026縣市長選舉最新報導',
          numberOfItems: structuredNewsItems.length,
          itemListOrder: 'https://schema.org/ItemListOrderDescending',
          itemListElement: structuredNewsItems
        }]
      : [])
  ]
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  shareImage={shareImageUrl}
  shareImageAlt="2026九合一選舉今周戰情室"
  structuredData={structuredData}
  footerBgColor={footerBgColor}
>
  <Header client:load />

  <main>
    {componentVisibility.KV && <KV client:load />}

    {componentVisibility.Seats && <Seats history={seatHistory} client:load />}

    {componentVisibility.VoteAnalysis && <VoteAnalysis stat={electionStat} client:load />}

    {componentVisibility.PartyHistory && <PartyHistory client:load />}

  </main>
</Layout>
